# Vercel server configuration (never prefix credentials with NEXT_PUBLIC_)
AUDITOR_WORKER_URL=https://your-worker.up.railway.app
AUDITOR_WORKER_TOKEN=
# OPENAI_API_KEY belongs on the Railway worker, not in the browser.
# Railway only: Browser Use Cloud API key (private)
BROWSER_USE_API_KEY=
# Set true only after the FEPY administrator permits automated auditor access.
FEPY_AUDITOR_ACCESS_APPROVED=false

# Private shared workspace. Generate secrets locally; never commit actual values.
AUDITOR_APP_PASSWORD=
AUDITOR_SESSION_SECRET=
